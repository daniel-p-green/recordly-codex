.DS_Store
**/.DS_Store

# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Build, coverage, and release artifacts
coverage/
dist/
*.tsbuildinfo

# The standalone MCP runtime is deliberately committed for marketplace installs.
plugin-runtime/*
!plugin-runtime/
!plugin-runtime/recordly-codex-mcp.mjs

# Local recording artifacts. Keep source fixtures intentionally added under test/.
recordings/
artifacts/
tmp/
.playwright-mcp/

# Finder / editor duplicate copies (never commit)
**/* 2.*
**/* 3.*
**/* copy.*
**/* Copy.*

# Local environment and editor state
.env
.env.*
!.env.example
.idea/
.vscode/
.cursor/
