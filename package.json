{
  "name": "recordly-codex",
  "version": "1.0.0",
  "description": "A Codex plugin for evidence-backed browser capture and deterministic editable recording projects.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.17.0 <25",
    "npm": ">=11.0.0"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "browser/capture-runtime.js",
    "contracts/host-support-v1-candidate.json",
    "contracts/runtime-integrity-v1-candidate.json",
    "plugin-runtime/recordly-codex-mcp.mjs",
    "scripts/self-check.mjs",
    "skills/recordly-codex/SKILL.md",
    "skills/recordly-codex/agents/openai.yaml"
  ],
  "scripts": {
    "acceptance:v1:validate": "node scripts/validate-v1-acceptance.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "bundle": "node scripts/build-mcp-bundle.mjs",
    "bundle:check": "node scripts/build-mcp-bundle.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run bundle:check && npm run test && npm run fixtures:validate && npm run pack:check",
    "fixtures:output-parity:validate": "node scripts/validate-output-parity-fixtures.mjs",
    "fixtures:validate": "node scripts/validate-fixtures.mjs",
    "format": "biome format --write .",
    "format:check": "node scripts/run-tracked-biome.mjs format",
    "lint": "node scripts/run-tracked-biome.mjs lint",
    "pack:check": "node scripts/pack-check.mjs",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "prepare": "npm run build && npm run bundle:check",
    "self-check": "node scripts/self-check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "0.28.1",
    "playwright-core": "^1.58.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
