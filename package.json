{
  "name": "recordly-codex",
  "version": "0.1.0",
  "description": "A Codex plugin foundation for browser-directed, deterministic site recordings.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run fixtures:validate",
    "fixtures:validate": "node scripts/validate-fixtures.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "playwright-core": "^1.58.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
